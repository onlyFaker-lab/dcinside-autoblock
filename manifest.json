{
  "manifest_version": 3,
  "name": "디시 자동 갱신차단",
  "version": "1.5.4",
  "description": "차단이 만료된 악성 유저를 감지해 31일 재차단합니다. 마이너 갤러리 매니저·부매니저용.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "https://gall.dcinside.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "디시 자동 갱신차단",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
